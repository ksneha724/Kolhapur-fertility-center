    $('.q').on("click", function(){
  var $speed = "400",
      $this = $(this);
  
  $(this).toggleClass('active')
     .siblings()
     .removeClass('active')
     .end()
  
     .next()
     .slideToggle($speed)
     .siblings('.a')
     .slideUp();
});


